# ── Supabase (requerido) ────────────────────────────────────────────────────
# Copia este archivo a ".env" y rellena los valores de tu proyecto Supabase.
# Los encuentras en: Supabase → Project Settings → API.
# Solo las variables con prefijo VITE_ se exponen al cliente (es seguro: la
# anon key es pública por diseño y los datos se protegen con RLS, ver supabase/schema.sql).
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_key_de_supabase_aqui

# ── Funciones serverless (opcional, solo en Vercel) ─────────────────────────
# Estas variables NO llevan prefijo VITE_: viven solo en el servidor (api/) y
# nunca se envían al navegador. La app web funciona sin ellas; solo afectan a
# las funciones de /api.

# Buzón de Web3Forms al que /api/feedback reenvía los mensajes del formulario
# de feedback. Crea una "access key" gratis en https://web3forms.com.
WEB3FORMS_ACCESS_KEY=tu_access_key_de_web3forms

# Patrones extra a ignorar al parsear estados de cuenta en /api/parse-pdf
# (p. ej. el nombre del titular o su email, que aparecen en el PDF). Lista
# separada por comas. Se mantiene fuera del código para no versionar PII.
# STATEMENT_SKIP_PATTERNS=NOMBRE APELLIDO,correo@ejemplo.com

# ── Recordatorios de pago de tarjetas (opcional, solo en Vercel) ────────────
# Los usa el cron diario /api/cron/card-reminders, configurado en vercel.json.
# Sin estas variables el endpoint responde 503 y no envía nada: la app sigue
# funcionando igual, solo no llegan los correos.

# API key de Resend (https://resend.com), el servicio que entrega los correos.
RESEND_API_KEY=re_tu_api_key_de_resend

# Remitente. El sandbox onboarding@resend.dev funciona sin configurar dominio,
# pero SOLO entrega al correo dueño de la cuenta Resend. Para enviar a cualquier
# dirección hay que verificar un dominio propio en Resend y cambiarlo aquí.
REMINDER_FROM=FinTrack <onboarding@resend.dev>

# Secreto que autentica al cron. Vercel Cron lo manda como `Authorization:
# Bearer <valor>` automáticamente al definir esta variable en el proyecto.
# Genéralo con: openssl rand -hex 32
CRON_SECRET=genera_un_secreto_aleatorio_largo

# ⚠️ service_role key de Supabase (Project Settings → API). SALTA RLS y puede
# leer los datos de TODOS los usuarios: el cron la necesita porque corre sin
# sesión. Va SOLO en el entorno servidor de Vercel; nunca en el navegador ni
# en un archivo versionado.
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_de_supabase

# URL base de la app, para el enlace "Ver mis tarjetas" del correo.
APP_URL=https://fintrack-rd.vercel.app

# Zona horaria con la que se decide "hoy" (las fechas de pago son día del mes).
# REMINDER_TIMEZONE=America/Santo_Domingo
