{
  "name": "fintrack",
  "version": "1.0.0",
  "description": "FinTrack — personal-finance PWA: zero-based budgeting, credit cards, debts and savings goals. React 19 + Vite + Supabase.",
  "private": true,
  "license": "MIT",
  "author": "Giancarlos Estévez",
  "homepage": "https://fintrack-rd.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gian-DS1/fintrack.git"
  },
  "bugs": {
    "url": "https://github.com/Gian-DS1/fintrack/issues"
  },
  "keywords": [
    "personal-finance",
    "budgeting",
    "zero-based-budgeting",
    "react",
    "vite",
    "supabase",
    "pwa",
    "tailwindcss",
    "zustand"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "knip": {
    "entry": [
      "src/main.jsx",
      "api/**/*.js"
    ],
    "project": [
      "src/**",
      "api/**"
    ]
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "framer-motion": "^12.40.0",
    "papaparse": "^5.5.3",
    "pdf-parse": "^1.1.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.8.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "emoji-toolkit": "^10.0.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "tailwindcss": "^4.3.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.7"
  }
}
